{
  "framework": "vite",
  "installCommand": "corepack pnpm@10.15.1 --dir apps/web install --frozen-lockfile",
  "buildCommand": "corepack pnpm@10.15.1 --dir apps/web run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.trycloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
    ]
  }]
}
